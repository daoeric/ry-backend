<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.business.mapper.TMerchantMessageMapper">
    
    <resultMap type="TMerchantMessage" id="TMerchantMessageResult">
        <result property="id"    column="id"    />
        <result property="title"    column="title"    />
        <result property="content"    column="content"    />
        <result property="customerId"    column="customer_id"    />
        <result property="status"    column="status"    />
        <result property="type"    column="type"    />
        <result property="createTime"    column="create_time"    />
        <result property="readTime"    column="read_time"    />
    </resultMap>
    
    <sql id="selectTMerchantMessageVo">
        select id, title, content, customer_id, status, type, create_time, read_time from t_merchant_message
    </sql>
    
    <select id="selectTMerchantMessageList" parameterType="TMerchantMessage" resultMap="TMerchantMessageResult">
        <include refid="selectTMerchantMessageVo"/>
        <where>  
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="customerId != null "> and customer_id = #{customerId}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="type != null "> and type = #{type}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectTMerchantMessageById" parameterType="Long" resultMap="TMerchantMessageResult">
        <include refid="selectTMerchantMessageVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertTMerchantMessage" parameterType="TMerchantMessage" useGeneratedKeys="true" keyProperty="id">
        insert into t_merchant_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="status != null">status,</if>
            <if test="type != null">type,</if>
            <if test="createTime != null">create_time,</if>
            <if test="readTime != null">read_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="status != null">#{status},</if>
            <if test="type != null">#{type},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="readTime != null">#{readTime},</if>
         </trim>
    </insert>
     
    <update id="updateTMerchantMessage" parameterType="TMerchantMessage">
        update t_merchant_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="type != null">type = #{type},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="readTime != null">read_time = #{readTime},</if>
        </trim>
        where id = #{id}
    </update>
    
    <delete id="deleteTMerchantMessageById" parameterType="Long">
        delete from t_merchant_message where id = #{id}
    </delete>
    
    <delete id="deleteTMerchantMessageByIds" parameterType="String">
        delete from t_merchant_message where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <select id="selectUnreadCountByCustomerId" parameterType="Long" resultType="int">
        select count(*) from t_merchant_message 
        where (customer_id = #{customerId} or customer_id is null) and status = 0
    </select>
    
    <select id="selectMessagesByCustomerId" resultMap="TMerchantMessageResult">
        select id, title, content, customer_id, status, type, create_time, read_time 
        from t_merchant_message 
        where (customer_id = #{customerId} or customer_id is null)
        order by create_time desc
        limit #{offset}, #{limit}
    </select>
    
    <update id="markAllAsRead">
        update t_merchant_message 
        set status = 1, read_time = NOW() 
        where (customer_id = #{customerId} or customer_id is null) and status = 0
    </update>
</mapper>